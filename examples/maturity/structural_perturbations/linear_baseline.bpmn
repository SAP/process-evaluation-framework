<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_linear_baseline"
             targetNamespace="http://example.org/bpmn"
             exporter="manual"
             exporterVersion="1.0">

  <process id="process_linear_baseline" name="Order Fulfillment (baseline)" isExecutable="true">

    <startEvent id="start" name="Start">
      <outgoing>flow_start_to_receive</outgoing>
    </startEvent>

    <task id="receive" name="receive order">
      <incoming>flow_start_to_receive</incoming>
      <outgoing>flow_receive_to_validate</outgoing>
    </task>

    <task id="validate" name="validate order">
      <incoming>flow_receive_to_validate</incoming>
      <outgoing>flow_validate_to_approve</outgoing>
    </task>

    <task id="approve" name="approve order">
      <incoming>flow_validate_to_approve</incoming>
      <outgoing>flow_approve_to_dispatch</outgoing>
    </task>

    <task id="dispatch" name="dispatch order">
      <incoming>flow_approve_to_dispatch</incoming>
      <outgoing>flow_dispatch_to_end</outgoing>
    </task>

    <endEvent id="end" name="End">
      <incoming>flow_dispatch_to_end</incoming>
    </endEvent>

    <sequenceFlow id="flow_start_to_receive" sourceRef="start" targetRef="receive"/>
    <sequenceFlow id="flow_receive_to_validate" sourceRef="receive" targetRef="validate"/>
    <sequenceFlow id="flow_validate_to_approve" sourceRef="validate" targetRef="approve"/>
    <sequenceFlow id="flow_approve_to_dispatch" sourceRef="approve" targetRef="dispatch"/>
    <sequenceFlow id="flow_dispatch_to_end" sourceRef="dispatch" targetRef="end"/>

  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="process_linear_baseline">

      <bpmndi:BPMNShape id="shape_start" bpmnElement="start">
        <dc:Bounds x="100" y="200" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_receive" bpmnElement="receive">
        <dc:Bounds x="180" y="178" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_validate" bpmnElement="validate">
        <dc:Bounds x="320" y="178" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_approve" bpmnElement="approve">
        <dc:Bounds x="460" y="178" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_dispatch" bpmnElement="dispatch">
        <dc:Bounds x="600" y="178" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_end" bpmnElement="end">
        <dc:Bounds x="740" y="200" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="edge_start_to_receive" bpmnElement="flow_start_to_receive">
        <di:waypoint x="136" y="218"/>
        <di:waypoint x="180" y="218"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_receive_to_validate" bpmnElement="flow_receive_to_validate">
        <di:waypoint x="280" y="218"/>
        <di:waypoint x="320" y="218"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_validate_to_approve" bpmnElement="flow_validate_to_approve">
        <di:waypoint x="420" y="218"/>
        <di:waypoint x="460" y="218"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_approve_to_dispatch" bpmnElement="flow_approve_to_dispatch">
        <di:waypoint x="560" y="218"/>
        <di:waypoint x="600" y="218"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_dispatch_to_end" bpmnElement="flow_dispatch_to_end">
        <di:waypoint x="700" y="218"/>
        <di:waypoint x="740" y="218"/>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</definitions>
