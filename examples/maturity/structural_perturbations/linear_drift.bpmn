<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_linear_drift"
             targetNamespace="http://example.org/bpmn"
             exporter="manual"
             exporterVersion="1.0">

  <!-- "Drift" variant: more perturbed than linear_reorder.bpmn. Same 4
       task vocabulary as the baseline (receive/validate/approve/dispatch
       order), but combines TWO perturbations:
         1. The validate ↔ approve swap from linear_reorder, and
         2. A rework back-edge from "approve order" via an exclusive
            decision gateway, merged back into the forward flow through
            an explicit exclusive join gateway before "validate order".
       Strictly more structural change than reorder alone (extra split
       AND extra join), so the test can assert monotonicity:
       base-vs-drift < base-vs-reorder. The explicit join makes the
       perturbation legible in the viewer — both "forward" and "rework"
       flows converge at a gateway diamond rather than implicitly
       merging at the validate task. -->

  <process id="process_linear_drift" name="Order Fulfillment (drift = reorder + rework loop)" isExecutable="true">

    <startEvent id="start" name="Start">
      <outgoing>flow_start_to_receive</outgoing>
    </startEvent>

    <task id="receive" name="receive order">
      <incoming>flow_start_to_receive</incoming>
      <outgoing>flow_receive_to_approve</outgoing>
    </task>

    <task id="approve" name="approve order">
      <incoming>flow_receive_to_approve</incoming>
      <outgoing>flow_approve_to_decision</outgoing>
    </task>

    <exclusiveGateway id="decision" name="approve OK?">
      <incoming>flow_approve_to_decision</incoming>
      <outgoing>flow_decision_to_join</outgoing>
      <outgoing>flow_rework_to_join</outgoing>
    </exclusiveGateway>

    <exclusiveGateway id="join" name="merge">
      <incoming>flow_decision_to_join</incoming>
      <incoming>flow_rework_to_join</incoming>
      <outgoing>flow_join_to_validate</outgoing>
    </exclusiveGateway>

    <task id="validate" name="validate order">
      <incoming>flow_join_to_validate</incoming>
      <outgoing>flow_validate_to_dispatch</outgoing>
    </task>

    <task id="dispatch" name="dispatch order">
      <incoming>flow_validate_to_dispatch</incoming>
      <outgoing>flow_dispatch_to_end</outgoing>
    </task>

    <endEvent id="end" name="End">
      <incoming>flow_dispatch_to_end</incoming>
    </endEvent>

    <sequenceFlow id="flow_start_to_receive" sourceRef="start" targetRef="receive"/>
    <sequenceFlow id="flow_receive_to_approve" sourceRef="receive" targetRef="approve"/>
    <sequenceFlow id="flow_approve_to_decision" sourceRef="approve" targetRef="decision"/>
    <sequenceFlow id="flow_decision_to_join" sourceRef="decision" targetRef="join" name="forward"/>
    <sequenceFlow id="flow_rework_to_join" sourceRef="decision" targetRef="join" name="rework"/>
    <sequenceFlow id="flow_join_to_validate" sourceRef="join" targetRef="validate"/>
    <sequenceFlow id="flow_validate_to_dispatch" sourceRef="validate" targetRef="dispatch"/>
    <sequenceFlow id="flow_dispatch_to_end" sourceRef="dispatch" targetRef="end"/>

  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="process_linear_drift">

      <bpmndi:BPMNShape id="shape_start" bpmnElement="start">
        <dc:Bounds x="100" y="200" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_receive" bpmnElement="receive">
        <dc:Bounds x="180" y="178" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_approve" bpmnElement="approve">
        <dc:Bounds x="320" y="178" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_decision" bpmnElement="decision" isMarkerVisible="true">
        <dc:Bounds x="460" y="193" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_join" bpmnElement="join" isMarkerVisible="true">
        <dc:Bounds x="560" y="193" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_validate" bpmnElement="validate">
        <dc:Bounds x="660" y="178" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_dispatch" bpmnElement="dispatch">
        <dc:Bounds x="800" y="178" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_end" bpmnElement="end">
        <dc:Bounds x="940" y="200" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="edge_start_to_receive" bpmnElement="flow_start_to_receive">
        <di:waypoint x="136" y="218"/>
        <di:waypoint x="180" y="218"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_receive_to_approve" bpmnElement="flow_receive_to_approve">
        <di:waypoint x="280" y="218"/>
        <di:waypoint x="320" y="218"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_approve_to_decision" bpmnElement="flow_approve_to_decision">
        <di:waypoint x="420" y="218"/>
        <di:waypoint x="460" y="218"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_decision_to_join" bpmnElement="flow_decision_to_join">
        <di:waypoint x="510" y="218"/>
        <di:waypoint x="560" y="218"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_rework_to_join" bpmnElement="flow_rework_to_join">
        <di:waypoint x="485" y="193"/>
        <di:waypoint x="485" y="120"/>
        <di:waypoint x="585" y="120"/>
        <di:waypoint x="585" y="193"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_join_to_validate" bpmnElement="flow_join_to_validate">
        <di:waypoint x="610" y="218"/>
        <di:waypoint x="660" y="218"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_validate_to_dispatch" bpmnElement="flow_validate_to_dispatch">
        <di:waypoint x="760" y="218"/>
        <di:waypoint x="800" y="218"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_dispatch_to_end" bpmnElement="flow_dispatch_to_end">
        <di:waypoint x="900" y="218"/>
        <di:waypoint x="940" y="218"/>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</definitions>
