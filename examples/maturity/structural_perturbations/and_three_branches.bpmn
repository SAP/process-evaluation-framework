<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_1"
             targetNamespace="http://example.org/bpmn"
             exporter="manual"
             exporterVersion="1.0">

  <process id="process_and_three_branches" name="AND Gateway Three Branches No Join (3 tokens in end)" isExecutable="true">

    <!-- Start Event -->
    <startEvent id="start" name="Start">
      <outgoing>flow_start_to_split</outgoing>
    </startEvent>

    <!-- AND Split Gateway -->
    <parallelGateway id="split" name="AND Split">
      <incoming>flow_start_to_split</incoming>
      <outgoing>flow_split_to_taskA</outgoing>
      <outgoing>flow_split_to_taskB</outgoing>
      <outgoing>flow_split_to_taskC</outgoing>
    </parallelGateway>

    <!-- Task A -->
    <task id="taskA" name="Task A">
      <incoming>flow_split_to_taskA</incoming>
      <outgoing>flow_taskA_to_end</outgoing>
    </task>

    <!-- Task B -->
    <task id="taskB" name="Task B">
      <incoming>flow_split_to_taskB</incoming>
      <outgoing>flow_taskB_to_end</outgoing>
    </task>

    <!-- Task C -->
    <task id="taskC" name="Task C">
      <incoming>flow_split_to_taskC</incoming>
      <outgoing>flow_taskC_to_end</outgoing>
    </task>

    <!-- End Event (receives 3 tokens - no synchronizing join) -->
    <endEvent id="end" name="End">
      <incoming>flow_taskA_to_end</incoming>
      <incoming>flow_taskB_to_end</incoming>
      <incoming>flow_taskC_to_end</incoming>
    </endEvent>

    <!-- Sequence Flows -->
    <sequenceFlow id="flow_start_to_split" sourceRef="start" targetRef="split"/>
    <sequenceFlow id="flow_split_to_taskA" sourceRef="split" targetRef="taskA"/>
    <sequenceFlow id="flow_split_to_taskB" sourceRef="split" targetRef="taskB"/>
    <sequenceFlow id="flow_split_to_taskC" sourceRef="split" targetRef="taskC"/>
    <sequenceFlow id="flow_taskA_to_end" sourceRef="taskA" targetRef="end"/>
    <sequenceFlow id="flow_taskB_to_end" sourceRef="taskB" targetRef="end"/>
    <sequenceFlow id="flow_taskC_to_end" sourceRef="taskC" targetRef="end"/>

  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="process_and_three_branches">

      <bpmndi:BPMNShape id="shape_start" bpmnElement="start">
        <dc:Bounds x="100" y="230" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_split" bpmnElement="split">
        <dc:Bounds x="200" y="223" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_taskA" bpmnElement="taskA">
        <dc:Bounds x="330" y="90" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_taskB" bpmnElement="taskB">
        <dc:Bounds x="330" y="210" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_taskC" bpmnElement="taskC">
        <dc:Bounds x="330" y="330" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_end" bpmnElement="end">
        <dc:Bounds x="520" y="230" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="edge_flow_start_to_split" bpmnElement="flow_start_to_split">
        <di:waypoint x="136" y="248"/>
        <di:waypoint x="200" y="248"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_flow_split_to_taskA" bpmnElement="flow_split_to_taskA">
        <di:waypoint x="225" y="223"/>
        <di:waypoint x="225" y="130"/>
        <di:waypoint x="330" y="130"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_flow_split_to_taskB" bpmnElement="flow_split_to_taskB">
        <di:waypoint x="250" y="248"/>
        <di:waypoint x="330" y="250"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_flow_split_to_taskC" bpmnElement="flow_split_to_taskC">
        <di:waypoint x="225" y="273"/>
        <di:waypoint x="225" y="370"/>
        <di:waypoint x="330" y="370"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_flow_taskA_to_end" bpmnElement="flow_taskA_to_end">
        <di:waypoint x="430" y="130"/>
        <di:waypoint x="538" y="130"/>
        <di:waypoint x="538" y="230"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_flow_taskB_to_end" bpmnElement="flow_taskB_to_end">
        <di:waypoint x="430" y="250"/>
        <di:waypoint x="520" y="248"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_flow_taskC_to_end" bpmnElement="flow_taskC_to_end">
        <di:waypoint x="430" y="370"/>
        <di:waypoint x="538" y="370"/>
        <di:waypoint x="538" y="266"/>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</definitions>
