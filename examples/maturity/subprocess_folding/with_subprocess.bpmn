<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_1"
             targetNamespace="http://example.org/bpmn/maturity"
             exporter="generate_small_models.py"
             exporterVersion="1.0">
  <process id="subprocess_dispatch" name="With Subprocess" isExecutable="true">
    <startEvent id="start" name="Start">
      <outgoing>flow_0</outgoing>
    </startEvent>
    <task id="outer_1" name="Pick">
      <incoming>flow_0</incoming>
      <outgoing>flow_1</outgoing>
    </task>
    <subProcess id="sp_1" name="Inner Subprocess">
      <incoming>flow_1</incoming>
      <outgoing>flow_2</outgoing>
      <startEvent id="sp_start">
      <outgoing>sp_flow_0</outgoing>
      </startEvent>
      <task id="inner_1" name="Pack">
        <incoming>sp_flow_0</incoming>
        <outgoing>sp_flow_1</outgoing>
      </task>
      <task id="inner_2" name="Label">
        <incoming>sp_flow_1</incoming>
        <outgoing>sp_flow_2</outgoing>
      </task>
      <task id="inner_3" name="Load">
        <incoming>sp_flow_2</incoming>
        <outgoing>sp_flow_3</outgoing>
      </task>
      <endEvent id="sp_end">
      <incoming>sp_flow_3</incoming>
      </endEvent>
      <sequenceFlow id="sp_flow_0" sourceRef="sp_start" targetRef="inner_1"/>
      <sequenceFlow id="sp_flow_1" sourceRef="inner_1" targetRef="inner_2"/>
      <sequenceFlow id="sp_flow_2" sourceRef="inner_2" targetRef="inner_3"/>
      <sequenceFlow id="sp_flow_3" sourceRef="inner_3" targetRef="sp_end"/>
    </subProcess>
    <task id="outer_2" name="Dispatch">
      <incoming>flow_2</incoming>
      <outgoing>flow_3</outgoing>
    </task>
    <endEvent id="end" name="End">
      <incoming>flow_3</incoming>
    </endEvent>
    <sequenceFlow id="flow_0" sourceRef="start" targetRef="outer_1"/>
    <sequenceFlow id="flow_1" sourceRef="outer_1" targetRef="sp_1"/>
    <sequenceFlow id="flow_2" sourceRef="sp_1" targetRef="outer_2"/>
    <sequenceFlow id="flow_3" sourceRef="outer_2" targetRef="end"/>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="subprocess_dispatch">
      <bpmndi:BPMNShape id="shape_start" bpmnElement="start">
        <dc:Bounds x="100" y="182" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_outer_1" bpmnElement="outer_1">
        <dc:Bounds x="240" y="160" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_sp_1" bpmnElement="sp_1">
        <dc:Bounds x="410" y="100" width="460" height="200"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_inner_1" bpmnElement="inner_1">
        <dc:Bounds x="450" y="160" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_inner_2" bpmnElement="inner_2">
        <dc:Bounds x="590" y="160" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_inner_3" bpmnElement="inner_3">
        <dc:Bounds x="730" y="160" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_outer_2" bpmnElement="outer_2">
        <dc:Bounds x="940" y="160" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_end" bpmnElement="end">
        <dc:Bounds x="1110" y="182" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="edge_flow_0" bpmnElement="flow_0">
        <di:waypoint x="136" y="200"/>
        <di:waypoint x="240" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_flow_1" bpmnElement="flow_1">
        <di:waypoint x="340" y="200"/>
        <di:waypoint x="410" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_flow_2" bpmnElement="flow_2">
        <di:waypoint x="870" y="200"/>
        <di:waypoint x="940" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_flow_3" bpmnElement="flow_3">
        <di:waypoint x="1040" y="200"/>
        <di:waypoint x="1110" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_sp_flow_0" bpmnElement="sp_flow_0">
        <di:waypoint x="430" y="200"/>
        <di:waypoint x="450" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_sp_flow_1" bpmnElement="sp_flow_1">
        <di:waypoint x="550" y="200"/>
        <di:waypoint x="590" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_sp_flow_2" bpmnElement="sp_flow_2">
        <di:waypoint x="690" y="200"/>
        <di:waypoint x="730" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_sp_flow_3" bpmnElement="sp_flow_3">
        <di:waypoint x="830" y="200"/>
        <di:waypoint x="850" y="200"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
