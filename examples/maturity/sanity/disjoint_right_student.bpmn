<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_student_enrollment"
             targetNamespace="http://example.org/bpmn"
             exporter="manual"
             exporterVersion="1.0">

  <!-- Disjoint partner for disjoint_left_credit.bpmn: a genuine
       student-enrollment process. Vocabulary deliberately shares no
       tokens with the credit-approval process so the disjoint floor
       measures domain disagreement, not incidental vocabulary reuse. -->

  <process id="process_student_enrollment" name="Student Enrollment" isExecutable="true">

    <startEvent id="start" name="Application received">
      <outgoing>flow_start_to_submit</outgoing>
    </startEvent>

    <task id="submit" name="Submit application">
      <incoming>flow_start_to_submit</incoming>
      <outgoing>flow_submit_to_review</outgoing>
    </task>

    <task id="review" name="Review transcript">
      <incoming>flow_submit_to_review</incoming>
      <outgoing>flow_review_to_interview</outgoing>
    </task>

    <task id="interview" name="Interview candidate">
      <incoming>flow_review_to_interview</incoming>
      <outgoing>flow_interview_to_send</outgoing>
    </task>

    <task id="send" name="Send acceptance letter">
      <incoming>flow_interview_to_send</incoming>
      <outgoing>flow_send_to_end</outgoing>
    </task>

    <endEvent id="end" name="Student enrolled">
      <incoming>flow_send_to_end</incoming>
    </endEvent>

    <sequenceFlow id="flow_start_to_submit" sourceRef="start" targetRef="submit"/>
    <sequenceFlow id="flow_submit_to_review" sourceRef="submit" targetRef="review"/>
    <sequenceFlow id="flow_review_to_interview" sourceRef="review" targetRef="interview"/>
    <sequenceFlow id="flow_interview_to_send" sourceRef="interview" targetRef="send"/>
    <sequenceFlow id="flow_send_to_end" sourceRef="send" targetRef="end"/>

  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="process_student_enrollment">

      <bpmndi:BPMNShape id="shape_start" bpmnElement="start">
        <dc:Bounds x="100" y="200" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_submit" bpmnElement="submit">
        <dc:Bounds x="180" y="178" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_review" bpmnElement="review">
        <dc:Bounds x="320" y="178" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_interview" bpmnElement="interview">
        <dc:Bounds x="460" y="178" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_send" bpmnElement="send">
        <dc:Bounds x="600" y="178" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_end" bpmnElement="end">
        <dc:Bounds x="740" y="200" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="edge_start_to_submit" bpmnElement="flow_start_to_submit">
        <di:waypoint x="136" y="218"/>
        <di:waypoint x="180" y="218"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_submit_to_review" bpmnElement="flow_submit_to_review">
        <di:waypoint x="280" y="218"/>
        <di:waypoint x="320" y="218"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_review_to_interview" bpmnElement="flow_review_to_interview">
        <di:waypoint x="420" y="218"/>
        <di:waypoint x="460" y="218"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_interview_to_send" bpmnElement="flow_interview_to_send">
        <di:waypoint x="560" y="218"/>
        <di:waypoint x="600" y="218"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_send_to_end" bpmnElement="flow_send_to_end">
        <di:waypoint x="700" y="218"/>
        <di:waypoint x="740" y="218"/>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</definitions>
