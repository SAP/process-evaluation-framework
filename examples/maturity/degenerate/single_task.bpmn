<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_1"
             targetNamespace="http://example.org/bpmn/maturity"
             exporter="generate_small_models.py"
             exporterVersion="1.0">
  <process id="single_task" name="Single Task" isExecutable="true">
    <startEvent id="start" name="Start">
      <outgoing>flow_0</outgoing>
    </startEvent>
    <task id="task_1" name="Do the thing">
      <incoming>flow_0</incoming>
      <outgoing>flow_1</outgoing>
    </task>
    <endEvent id="end" name="End">
      <incoming>flow_1</incoming>
    </endEvent>
    <sequenceFlow id="flow_0" sourceRef="start" targetRef="task_1"/>
    <sequenceFlow id="flow_1" sourceRef="task_1" targetRef="end"/>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="single_task">
      <bpmndi:BPMNShape id="shape_start" bpmnElement="start">
        <dc:Bounds x="100" y="182" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_task_1" bpmnElement="task_1">
        <dc:Bounds x="208" y="160" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_end" bpmnElement="end">
        <dc:Bounds x="378" y="182" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="edge_flow_0" bpmnElement="flow_0">
        <di:waypoint x="136" y="200"/>
        <di:waypoint x="208" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_flow_1" bpmnElement="flow_1">
        <di:waypoint x="308" y="200"/>
        <di:waypoint x="378" y="200"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
