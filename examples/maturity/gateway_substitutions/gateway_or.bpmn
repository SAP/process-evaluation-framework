<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_gateway_or"
             targetNamespace="http://example.org/bpmn"
             exporter="manual"
             exporterVersion="1.0">

  <process id="process_gateway_or" name="T-Shirt Order (OR Gateway)" isExecutable="true">

    <startEvent id="start" name="T-shirt is ordered">
      <outgoing>flow_start_to_receive</outgoing>
    </startEvent>

    <task id="receive" name="Receive Customer Order">
      <incoming>flow_start_to_receive</incoming>
      <outgoing>flow_receive_to_split</outgoing>
    </task>

    <inclusiveGateway id="split" name="OR Split">
      <incoming>flow_receive_to_split</incoming>
      <outgoing>flow_split_to_prepare_order</outgoing>
      <outgoing>flow_split_to_prepare_invoice</outgoing>
    </inclusiveGateway>

    <task id="prepare_order" name="Prepare Order">
      <incoming>flow_split_to_prepare_order</incoming>
      <outgoing>flow_prepare_order_to_join</outgoing>
    </task>

    <task id="prepare_invoice" name="Prepare Invoice">
      <incoming>flow_split_to_prepare_invoice</incoming>
      <outgoing>flow_prepare_invoice_to_join</outgoing>
    </task>

    <inclusiveGateway id="join" name="OR Join">
      <incoming>flow_prepare_order_to_join</incoming>
      <incoming>flow_prepare_invoice_to_join</incoming>
      <outgoing>flow_join_to_ship</outgoing>
    </inclusiveGateway>

    <task id="ship" name="Ship Order with Invoice">
      <incoming>flow_join_to_ship</incoming>
      <outgoing>flow_ship_to_end</outgoing>
    </task>

    <endEvent id="end" name="Order is sent">
      <incoming>flow_ship_to_end</incoming>
    </endEvent>

    <sequenceFlow id="flow_start_to_receive" sourceRef="start" targetRef="receive"/>
    <sequenceFlow id="flow_receive_to_split" sourceRef="receive" targetRef="split"/>
    <sequenceFlow id="flow_split_to_prepare_order" sourceRef="split" targetRef="prepare_order"/>
    <sequenceFlow id="flow_split_to_prepare_invoice" sourceRef="split" targetRef="prepare_invoice"/>
    <sequenceFlow id="flow_prepare_order_to_join" sourceRef="prepare_order" targetRef="join"/>
    <sequenceFlow id="flow_prepare_invoice_to_join" sourceRef="prepare_invoice" targetRef="join"/>
    <sequenceFlow id="flow_join_to_ship" sourceRef="join" targetRef="ship"/>
    <sequenceFlow id="flow_ship_to_end" sourceRef="ship" targetRef="end"/>

  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="process_gateway_or">

      <bpmndi:BPMNShape id="shape_start" bpmnElement="start">
        <dc:Bounds x="100" y="200" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_receive" bpmnElement="receive">
        <dc:Bounds x="180" y="178" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_split" bpmnElement="split">
        <dc:Bounds x="330" y="193" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_prepare_order" bpmnElement="prepare_order">
        <dc:Bounds x="430" y="100" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_prepare_invoice" bpmnElement="prepare_invoice">
        <dc:Bounds x="430" y="260" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_join" bpmnElement="join">
        <dc:Bounds x="580" y="193" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_ship" bpmnElement="ship">
        <dc:Bounds x="680" y="178" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_end" bpmnElement="end">
        <dc:Bounds x="830" y="200" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="edge_start_to_receive" bpmnElement="flow_start_to_receive">
        <di:waypoint x="136" y="218"/>
        <di:waypoint x="180" y="218"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_receive_to_split" bpmnElement="flow_receive_to_split">
        <di:waypoint x="280" y="218"/>
        <di:waypoint x="330" y="218"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_split_to_prepare_order" bpmnElement="flow_split_to_prepare_order">
        <di:waypoint x="355" y="193"/>
        <di:waypoint x="355" y="140"/>
        <di:waypoint x="430" y="140"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_split_to_prepare_invoice" bpmnElement="flow_split_to_prepare_invoice">
        <di:waypoint x="355" y="243"/>
        <di:waypoint x="355" y="300"/>
        <di:waypoint x="430" y="300"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_prepare_order_to_join" bpmnElement="flow_prepare_order_to_join">
        <di:waypoint x="530" y="140"/>
        <di:waypoint x="605" y="140"/>
        <di:waypoint x="605" y="193"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_prepare_invoice_to_join" bpmnElement="flow_prepare_invoice_to_join">
        <di:waypoint x="530" y="300"/>
        <di:waypoint x="605" y="300"/>
        <di:waypoint x="605" y="243"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_join_to_ship" bpmnElement="flow_join_to_ship">
        <di:waypoint x="630" y="218"/>
        <di:waypoint x="680" y="218"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_ship_to_end" bpmnElement="flow_ship_to_end">
        <di:waypoint x="780" y="218"/>
        <di:waypoint x="830" y="218"/>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</definitions>
