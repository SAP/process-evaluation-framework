<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_1"
             targetNamespace="http://example.org/bpmn"
             exporter="manual"
             exporterVersion="1.0">

  <process id="process_and_with_join" name="AND Gateway With Join" isExecutable="true">

    <!-- Start Event -->
    <startEvent id="start" name="Start">
      <outgoing>flow_start_to_split</outgoing>
    </startEvent>

    <!-- AND Split Gateway -->
    <parallelGateway id="split" name="AND Split">
      <incoming>flow_start_to_split</incoming>
      <outgoing>flow_split_to_taskA</outgoing>
      <outgoing>flow_split_to_taskB</outgoing>
    </parallelGateway>

    <!-- Task A -->
    <task id="taskA" name="Task A">
      <incoming>flow_split_to_taskA</incoming>
      <outgoing>flow_taskA_to_join</outgoing>
    </task>

    <!-- Task B -->
    <task id="taskB" name="Task B">
      <incoming>flow_split_to_taskB</incoming>
      <outgoing>flow_taskB_to_join</outgoing>
    </task>

    <!-- AND Join Gateway -->
    <parallelGateway id="join" name="AND Join">
      <incoming>flow_taskA_to_join</incoming>
      <incoming>flow_taskB_to_join</incoming>
      <outgoing>flow_join_to_end</outgoing>
    </parallelGateway>

    <!-- End Event -->
    <endEvent id="end" name="End">
      <incoming>flow_join_to_end</incoming>
    </endEvent>

    <!-- Sequence Flows -->
    <sequenceFlow id="flow_start_to_split" sourceRef="start" targetRef="split"/>
    <sequenceFlow id="flow_split_to_taskA" sourceRef="split" targetRef="taskA"/>
    <sequenceFlow id="flow_split_to_taskB" sourceRef="split" targetRef="taskB"/>
    <sequenceFlow id="flow_taskA_to_join" sourceRef="taskA" targetRef="join"/>
    <sequenceFlow id="flow_taskB_to_join" sourceRef="taskB" targetRef="join"/>
    <sequenceFlow id="flow_join_to_end" sourceRef="join" targetRef="end"/>

  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="process_and_with_join">

      <bpmndi:BPMNShape id="shape_start" bpmnElement="start">
        <dc:Bounds x="100" y="200" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_split" bpmnElement="split">
        <dc:Bounds x="200" y="193" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_taskA" bpmnElement="taskA">
        <dc:Bounds x="320" y="120" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_taskB" bpmnElement="taskB">
        <dc:Bounds x="320" y="240" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_join" bpmnElement="join">
        <dc:Bounds x="490" y="193" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_end" bpmnElement="end">
        <dc:Bounds x="600" y="200" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="edge_flow_start_to_split" bpmnElement="flow_start_to_split">
        <di:waypoint x="136" y="218"/>
        <di:waypoint x="200" y="218"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_flow_split_to_taskA" bpmnElement="flow_split_to_taskA">
        <di:waypoint x="225" y="193"/>
        <di:waypoint x="225" y="160"/>
        <di:waypoint x="320" y="160"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_flow_split_to_taskB" bpmnElement="flow_split_to_taskB">
        <di:waypoint x="225" y="243"/>
        <di:waypoint x="225" y="280"/>
        <di:waypoint x="320" y="280"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_flow_taskA_to_join" bpmnElement="flow_taskA_to_join">
        <di:waypoint x="420" y="160"/>
        <di:waypoint x="515" y="160"/>
        <di:waypoint x="515" y="193"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_flow_taskB_to_join" bpmnElement="flow_taskB_to_join">
        <di:waypoint x="420" y="280"/>
        <di:waypoint x="515" y="280"/>
        <di:waypoint x="515" y="243"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_flow_join_to_end" bpmnElement="flow_join_to_end">
        <di:waypoint x="540" y="218"/>
        <di:waypoint x="600" y="218"/>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</definitions>
