{
  "resourceId": "canvas",
  "properties": {
    "documentation_en_gb": "Booking hotel accommodations\nA traveler sends an accommodation request to a travel consultant once trip dates have been determined. The consultant checks availability with multiple hotels, compares offers received within 3 minutes, and proceeds with the most suitable booking. After reserving, the consultant sends a confirmation to the traveler, and the hotel dispatches a booking reference directly to the traveler.\n\nNote: Hotel internal processes are excluded.",
    "language": "English",
    "orientation": "horizontal",
    "meta-vertraulichkeit_en_gb": "Internal use only",
    "meta-modelingstatus": "Draft"
  },
  "stencil": { "id": "BPMNDiagram" },
  "childShapes": [
    {
      "resourceId": "PoolTraveler",
      "properties": { "name": "Traveler" },
      "stencil": { "id": "Pool" },
      "childShapes": [
        {
          "resourceId": "LaneTraveler",
          "stencil": { "id": "Lane" },
          "childShapes": [
            {
              "resourceId": "StartTravel",
              "stencil": { "id": "StartNoneEvent" },
              "properties": { "name": "Plan travel dates" },
              "outgoing": [{ "resourceId": "FlowT1" }],
              "bounds": { "upperLeft": { "x": 40, "y": 70 }, "lowerRight": { "x": 70, "y": 100 } }
            },
            {
              "resourceId": "TaskPrepareRequest",
              "stencil": { "id": "Task" },
              "properties": { "name": "Prepare accommodation request" },
              "outgoing": [{ "resourceId": "FlowT2" }],
              "bounds": { "upperLeft": { "x": 100, "y": 50 }, "lowerRight": { "x": 200, "y": 120 } }
            },
            {
              "resourceId": "EventSendRequest",
              "stencil": { "id": "IntermediateMessageEventThrowing" },
              "properties": { "name": "Send accommodation request", "trigger": "Message" },
              "outgoing": [{ "resourceId": "MessageToConsultant" }],
              "bounds": { "upperLeft": { "x": 240, "y": 70 }, "lowerRight": { "x": 270, "y": 100 } }
            },
            {
              "resourceId": "EventReceiveConfirm",
              "stencil": { "id": "IntermediateMessageEventCatching" },
              "properties": { "name": "Receive booking confirmation", "trigger": "Message" },
              "outgoing": [{ "resourceId": "FlowTEnd" }],
              "bounds": { "upperLeft": { "x": 610, "y": 70 }, "lowerRight": { "x": 640, "y": 100 } }
            },
            {
              "resourceId": "EndTravel",
              "stencil": { "id": "EndNoneEvent" },
              "properties": { "name": "Stay booked" },
              "bounds": { "upperLeft": { "x": 720, "y": 70 }, "lowerRight": { "x": 750, "y": 100 } }
            }
          ]
        }
      ],
      "bounds": { "upperLeft": { "x": 20, "y": 20 }, "lowerRight": { "x": 800, "y": 180 } }
    },
    {
      "resourceId": "PoolConsultant",
      "properties": { "name": "Travel Consultant" },
      "stencil": { "id": "Pool" },
      "childShapes": [
        {
          "resourceId": "LaneConsultant",
          "stencil": { "id": "Lane" },
          "childShapes": [
            {
              "resourceId": "StartConsultant",
              "stencil": { "id": "StartMessageEvent" },
              "properties": { "name": "Accommodation request received", "trigger": "Message" },
              "outgoing": [{ "resourceId": "FlowC1" }]
            },
            {
              "resourceId": "SubprocessCollectOffers",
              "stencil": { "id": "Subprocess" },
              "properties": { "name": "Request hotel availability", "subprocesstype": "Embedded" },
              "childShapes": [
                {
                  "resourceId": "EventSendAvailability",
                  "stencil": { "id": "IntermediateMessageEventThrowing" },
                  "properties": { "name": "Send request to hotels", "trigger": "Message" },
                  "outgoing": [{ "resourceId": "MessageToHotel" }]
                },
                {
                  "resourceId": "EventReceiveAvailability",
                  "stencil": { "id": "IntermediateMessageEventCatching" },
                  "properties": { "name": "Receive hotel offers", "trigger": "Message" }
                }
              ],
              "outgoing": [{ "resourceId": "FlowC2" }]
            },
            {
              "resourceId": "GatewaySelectOffer",
              "stencil": { "id": "Exclusive_Databased_Gateway" },
              "properties": { "name": "Best offer?" },
              "outgoing": [{ "resourceId": "FlowC3" }]
            },
            {
              "resourceId": "TaskReserveRoom",
              "stencil": { "id": "Task" },
              "properties": { "name": "Reserve selected room" },
              "outgoing": [{ "resourceId": "FlowC4" }]
            },
            {
              "resourceId": "EndSendConfirmation",
              "stencil": { "id": "EndMessageEvent" },
              "properties": { "name": "Send confirmation to traveler", "trigger": "Message" },
              "outgoing": [{ "resourceId": "MessageToTraveler" }]
            }
          ]
        }
      ],
      "bounds": { "upperLeft": { "x": 20, "y": 210 }, "lowerRight": { "x": 1220, "y": 360 } }
    },
    {
      "resourceId": "PoolHotel",
      "stencil": { "id": "CollapsedPool" },
      "properties": { "name": "Hotel", "multiinstance": "true", "minimum": "2", "maximum": "3" },
      "bounds": { "upperLeft": { "x": 400, "y": 400 }, "lowerRight": { "x": 1200, "y": 450 } }
    },

    { "resourceId": "FlowT1", "stencil": { "id": "SequenceFlow" }, "outgoing": [{ "resourceId": "TaskPrepareRequest" }] },
    { "resourceId": "FlowT2", "stencil": { "id": "SequenceFlow" }, "outgoing": [{ "resourceId": "EventSendRequest" }] },
    { "resourceId": "FlowTEnd", "stencil": { "id": "SequenceFlow" }, "outgoing": [{ "resourceId": "EndTravel" }] },

    { "resourceId": "FlowC1", "stencil": { "id": "SequenceFlow" }, "outgoing": [{ "resourceId": "SubprocessCollectOffers" }] },
    { "resourceId": "FlowC2", "stencil": { "id": "SequenceFlow" }, "outgoing": [{ "resourceId": "GatewaySelectOffer" }] },
    { "resourceId": "FlowC3", "stencil": { "id": "SequenceFlow" }, "outgoing": [{ "resourceId": "TaskReserveRoom" }] },
    { "resourceId": "FlowC4", "stencil": { "id": "SequenceFlow" }, "outgoing": [{ "resourceId": "EndSendConfirmation" }] },

    {
      "resourceId": "MessageToConsultant",
      "stencil": { "id": "MessageFlow" },
      "target": { "resourceId": "StartConsultant" }
    },
    {
      "resourceId": "MessageToHotel",
      "stencil": { "id": "MessageFlow" },
      "target": { "resourceId": "PoolHotel" }
    },
    {
      "resourceId": "MessageToTraveler",
      "stencil": { "id": "MessageFlow" },
      "target": { "resourceId": "EventReceiveConfirm" }
    }
  ],
  "bounds": { "upperLeft": { "x": 0, "y": 0 }, "lowerRight": { "x": 1300, "y": 700 } },
  "stencilset": {
    "url": "/stencilsets/bpmn2.0/bpmn2.0.json",
    "namespace": "http://b3mn.org/stencilset/bpmn2.0#"
  }
}